{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KCActivation",
  "type": "object",
  "additionalProperties": false,
  "required": ["opportunity_id", "split", "canonical_cell_id", "cell", "realization_spec", "realization_operations", "source_descriptor_ids", "source_mapping_notes", "kc_ids"],
  "properties": {
    "opportunity_id": {"type": "string", "pattern": "^OPP_[A-F0-9]{16}$"},
    "split": {"enum": ["development", "held_out"]},
    "canonical_cell_id": {"type": "string", "pattern": "^CELL_[A-F0-9]{16}$"},
    "cell": {"type": "object"},
    "realization_spec": {"type": "object"},
    "realization_operations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "source_descriptor_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "source_mapping_notes": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "kc_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
