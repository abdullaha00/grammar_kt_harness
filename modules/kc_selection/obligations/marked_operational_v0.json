{
  "obligation_policy_id": "MARKED_OPERATIONAL_v0",
  "description": "Reference markedness policy: represent finite tense and overt/marked structural values; treat active, positive, declarative, and modal=none as background.",
  "fact_rules": [
    {"fact_template": "tense:{tense}", "activation_rule": {"cell": {"tense": ["present", "past"]}}},
    {"fact": "aspect:perfect", "activation_rule": {"cell": {"aspect": ["perfect", "perfect_progressive"]}}},
    {"fact": "aspect:progressive", "activation_rule": {"cell": {"aspect": ["progressive", "perfect_progressive"]}}},
    {"fact": "voice:passive", "activation_rule": {"cell": {"voice": "passive"}}},
    {"fact": "polarity:negative", "activation_rule": {"cell": {"polarity": "negative"}}},
    {"fact_template": "clause:{clause}", "activation_rule": {"cell": {"clause": ["polar_question", "subject_wh_question", "non_subject_wh_question", "imperative"]}}},
    {"fact_template": "modal:{modal}", "activation_rule": {"cell": {"modal": ["can", "could", "may", "might", "must", "shall", "should", "will", "would"]}}}
  ],
  "background_values": {
    "voice": ["active"],
    "polarity": ["positive"],
    "clause": ["declarative"],
    "modal": ["none"],
    "aspect": ["none"]
  }
}
