{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["naturalness", "answer_ambiguity", "pedagogical_suitability", "world_knowledge_required", "lexical_cefr_appropriate", "dialogue_coherence", "pragmatic_licensing", "natural_speaker_turns", "context_appropriateness", "note"],
  "properties": {
    "naturalness": {"type": "integer", "minimum": 1, "maximum": 5},
    "answer_ambiguity": {"type": "boolean"},
    "pedagogical_suitability": {"type": "integer", "minimum": 1, "maximum": 5},
    "world_knowledge_required": {"type": "boolean"},
    "lexical_cefr_appropriate": {"type": "boolean"},
    "dialogue_coherence": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "pragmatic_licensing": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "natural_speaker_turns": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "context_appropriateness": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "note": {"type": "string"}
  }
}
