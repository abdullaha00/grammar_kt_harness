{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["cell", "operations", "predicate_class", "agreement_site"],
  "properties": {
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["tense", "aspect", "voice", "polarity", "clause", "modal"],
      "properties": {
        "tense": {"enum": ["present", "past", "NA"]},
        "aspect": {"enum": ["none", "perfect", "progressive", "perfect_progressive"]},
        "voice": {"enum": ["active", "passive"]},
        "polarity": {"enum": ["positive", "negative"]},
        "clause": {"enum": ["declarative", "polar_question", "subject_wh_question", "non_subject_wh_question", "imperative"]},
        "modal": {"enum": ["none", "can", "could", "may", "might", "must", "shall", "should", "will", "would"]}
      }
    },
    "operations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "predicate_class": {"enum": ["lexical_transitive", "lexical_intransitive", "copular"]},
    "agreement_site": {"enum": ["none", "modal", "do", "have", "be", "main_verb"]}
  }
}
