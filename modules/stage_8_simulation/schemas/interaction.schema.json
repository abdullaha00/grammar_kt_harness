{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "learner_id", "item_id", "sequence_index", "timestamp", "correct", "kc_ids", "opportunity_indices", "canonical_cell_id", "item_difficulty", "dataset_split"],
  "properties": {
    "event_id": {"type": "string"},
    "learner_id": {"type": "string"},
    "item_id": {"type": "string"},
    "sequence_index": {"type": "integer", "minimum": 1},
    "timestamp": {"type": "string"},
    "correct": {"enum": [0, 1]},
    "kc_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "opportunity_indices": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "canonical_cell_id": {"type": "string"},
    "item_difficulty": {"type": "number"},
    "dataset_split": {"enum": ["train", "validation", "test"]}
  }
}

