{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["tense", "aspect", "voice", "polarity", "clause", "modal"],
  "properties": {
    "tense": {"enum": ["present", "past", "NA"]},
    "aspect": {"enum": ["none", "progressive", "perfect", "perfect_progressive"]},
    "voice": {"enum": ["active", "passive"]},
    "polarity": {"enum": ["positive", "negative"]},
    "clause": {"enum": ["declarative", "polar_question", "subject_wh_question", "non_subject_wh_question", "imperative"]},
    "modal": {"enum": ["none", "can", "could", "may", "might", "must", "shall", "should", "will", "would"]}
  }
}

