{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GrammarCellRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "canonical_cell_id",
    "cell",
    "source_descriptor_count",
    "source_edge_count",
    "source_descriptor_ids",
    "source_mapping_notes"
  ],
  "properties": {
    "canonical_cell_id": {"type": "string", "pattern": "^CELL_[A-F0-9]{16}$"},
    "cell": {"type": "object"},
    "source_descriptor_count": {"type": "integer", "minimum": 1},
    "source_edge_count": {"type": "integer", "minimum": 1},
    "source_descriptor_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "source_mapping_notes": {
      "type": "object",
      "additionalProperties": {"type": ["string", "null"]}
    }
  }
}
