{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceCellEdge",
  "type": "object",
  "additionalProperties": false,
  "required": ["edge_id", "egp_id", "source_mapping_result", "source_cell_index", "canonical_cell_id", "source_note"],
  "properties": {
    "edge_id": {"type": "string", "pattern": "^EDGE_[A-F0-9]{16}$"},
    "egp_id": {"type": "string", "minLength": 1},
    "source_mapping_result": {"const": "complete"},
    "source_cell_index": {"type": "integer", "minimum": 0},
    "canonical_cell_id": {"type": "string", "pattern": "^CELL_[A-F0-9]{16}$"},
    "source_note": {"type": ["string", "null"]}
  }
}
