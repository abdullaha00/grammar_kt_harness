{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grammar-kt.local/schemas/programme-evidence-config-v1.json",
  "title": "Measurement-realism programme evidence configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "config_id",
    "status",
    "manifest_output",
    "manifest_schema",
    "protected_baseline",
    "dataset_release_decision",
    "required_group_ids",
    "evidence_groups",
    "exclusion_patterns",
    "required_absent_paths",
    "claim_assertions",
    "text_contracts",
    "reconstruction_commands"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "config_id": {"type": "string", "minLength": 1},
    "status": {"const": "PRE_FREEZE_EXPLICIT_ALLOWLIST"},
    "manifest_output": {"$ref": "#/$defs/relativePath"},
    "manifest_schema": {"$ref": "#/$defs/relativePath"},
    "protected_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "anchor_path",
        "source_commit",
        "expected_git_tree_object",
        "core_sha256"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "anchor_path": {"$ref": "#/$defs/relativePath"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expected_git_tree_object": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "core_sha256": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "dataset_release_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "candidate_path", "must_not_exist", "basis"],
      "properties": {
        "decision": {"const": "NO_NEW_DATASET_RELEASE"},
        "candidate_path": {"$ref": "#/$defs/relativePath"},
        "must_not_exist": {"const": true},
        "basis": {"type": "string", "minLength": 1}
      }
    },
    "required_group_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "purpose", "paths"],
        "properties": {
          "group_id": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/relativePath"}
          }
        }
      }
    },
    "exclusion_patterns": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "required_absent_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "claim_assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "path", "json_pointer", "equals"],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1},
          "path": {"$ref": "#/$defs/relativePath"},
          "json_pointer": {"type": "string", "pattern": "^/"},
          "equals": true
        }
      }
    },
    "text_contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract_id", "path", "required_casefold_phrases"],
        "properties": {
          "contract_id": {"type": "string", "minLength": 1},
          "path": {"$ref": "#/$defs/relativePath"},
          "required_casefold_phrases": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "forbidden_casefold_phrases": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "reconstruction_commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command_id", "kind", "purpose", "command"],
        "properties": {
          "command_id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "deterministic_reconstruction",
              "verification",
              "notebook_execution",
              "paper_build"
            ]
          },
          "purpose": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    }
  }
}
