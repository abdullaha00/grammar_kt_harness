{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measurement-realism-critic-batch-v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "batch_id", "families"],
  "properties": {
    "role": {"enum": ["linguistic", "measurement", "platform_product"]},
    "batch_id": {"type": "string", "minLength": 1},
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family_id", "candidate_id", "item_judgments", "family_judgments", "overall_accept", "summary"],
        "properties": {
          "family_id": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "item_judgments": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {"$ref": "#/$defs/itemJudgment"}
          },
          "family_judgments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
          "overall_accept": {"type": "boolean"},
          "summary": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "severity", "evidence", "blocking"],
      "properties": {
        "criterion": {"type": "string", "minLength": 1},
        "severity": {"enum": ["pass", "minor_concern", "major_concern"]},
        "evidence": {"type": "string", "minLength": 1},
        "blocking": {"type": "boolean"}
      }
    },
    "itemJudgment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "criteria"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}}
      }
    }
  }
}
