{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measurement-realism-call-record-v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id", "stage", "model", "reasoning_effort", "attempt_id", "status",
    "input_sha256", "prompt_sha256", "output_schema_sha256", "evidence_path",
    "raw_output_sha256", "parsed_output_sha256"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["generation", "solver", "validation"]},
    "model": {"type": "string", "minLength": 1},
    "reasoning_effort": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["complete", "technical_failure"]},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_path": {"type": "string", "minLength": 1},
    "raw_output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "parsed_output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
