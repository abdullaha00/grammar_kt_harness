  "properties": {
    "egp_id": {"type": "string", "minLength": 1},
    "supercategory": {"type": "string"},
    "subcategory": {"type": "string"},
    "guideword": {"type": "string"},
    "can_do": {"type": "string"},
    "examples": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}

